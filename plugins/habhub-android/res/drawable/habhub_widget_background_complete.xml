<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="2dp" android:top="3dp" android:right="2dp">
    <shape android:shape="rectangle">
      <solid android:color="#5A2C1800" />
      <corners android:radius="22dp" />
    </shape>
  </item>
  <item android:bottom="3dp">
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:startColor="#B87A0B"
        android:centerColor="#83530A"
        android:endColor="#432B08" />
      <corners android:radius="22dp" />
      <stroke android:width="1dp" android:color="#FFE08A" />
      <padding android:left="11dp" android:top="7dp" android:right="11dp" android:bottom="8dp" />
    </shape>
  </item>
</layer-list>
