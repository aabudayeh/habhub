  "main": "expo-router/entry",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "preview:web": "node scripts/serve-dist.cjs",
    "export:web": "node node_modules/expo/bin/cli export --platform web",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js app src",
    "validate:env": "node scripts/validate-release-env.cjs",
    "validate:cloud": "node scripts/validate-release-env.cjs --cloud",
    "check": "pnpm typecheck && pnpm lint",
    "check:release": "pnpm validate:cloud && pnpm typecheck && pnpm lint && pnpm export:web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "14.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
