    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.6",
    "expo": "~54.0.36",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
