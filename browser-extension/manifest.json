{
  "manifest_version": 3,
  "name": "HabHub",
  "version": "0.3.4",
  "description": "The complete HabHub app in a browser toolbar popup.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "habhub-icon.png",
    "32": "habhub-icon.png",
    "48": "habhub-icon.png",
    "128": "habhub-icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://habhub.expo.app/*"],
  "action": {
    "default_title": "HabHub",
    "default_icon": "habhub-icon.png",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://habhub.expo.app"
  }
}
