{
  "expo": {
    "name": "HabHub",
    "slug": "metrally",
    "version": "1.0.18",
    "orientation": "portrait",
    "icon": "./assets/images/habhub-store-icon.png",
    "scheme": "paceboard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.paceboard.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "HabHub reads only the health categories you choose so it can update your private goals and permitted group progress.",
        "NSHealthUpdateUsageDescription": "HabHub does not write health data unless you explicitly choose a future export feature.",
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_supportsRTL": true,
        "CFBundleLocalizations": [
          "en",
          "ar",
          "es",
          "zh",
          "sv",
          "de",
          "ru",
          "fr"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081B49",
        "backgroundImage": "./assets/images/habhub-adaptive-background.png",
        "foregroundImage": "./assets/images/habhub-adaptive-foreground.png",
        "monochromeImage": "./assets/images/habhub-adaptive-monochrome.png"
      },
      "package": "app.paceboard.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.PACKAGE_USAGE_STATS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/habhub-store-icon.png"
    },
    "locales": {
      "en": "./src/i18n/native/en.json",
      "ar": "./src/i18n/native/ar.json",
      "es": "./src/i18n/native/es.json",
      "zh": "./src/i18n/native/zh-Hans.json",
      "sv": "./src/i18n/native/sv.json",
      "de": "./src/i18n/native/de.json",
      "ru": "./src/i18n/native/ru.json",
      "fr": "./src/i18n/native/fr.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/habhub-notification-icon.png",
          "color": "#08BDB4",
          "defaultChannel": "paceboard",
          "mode": "production"
        }
      ],
      "./plugins/withAndroidNotificationMetadataOverrides",
      "expo-secure-store",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "HabHub reads only the health categories you choose so it can update your private goals and permitted group progress.",
          "NSHealthUpdateUsageDescription": "HabHub does not write health data unless you explicitly choose a future export feature.",
          "background": true
        }
      ],
      "expo-background-task",
      "react-native-health-connect",
      [
        "./plugins/withHealthConnectPrivacy",
        {
          "privacyUrl": "https://habhub.expo.app/privacy"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HabHub uses your photos only when you choose to attach an image to a log, workout, note, or progress update.",
          "cameraPermission": "HabHub uses your camera only when you choose to attach a photo to a log, workout, note, or progress update.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/habhub-splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#081B49",
          "dark": {
            "backgroundColor": "#081B49"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "ar",
            "es",
            "zh",
            "sv",
            "de",
            "ru",
            "fr"
          ],
          "supportsRTL": true
        }
      ],
      [
        "./plugins/withGoogleAssistant",
        {
          "scheme": "paceboard"
        }
      ],
      "./plugins/withHabHubAndroid"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/f7411fe5-5319-4476-b70b-d7e3a4252a5c"
    },
    "owner": "sethpapa",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7411fe5-5319-4476-b70b-d7e3a4252a5c"
      }
    }
  }
}
