# Optional. The app runs as a local demo without these values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Public HTTPS origin of the deployed Expo web app. Group invite links use it.
EXPO_PUBLIC_APP_URL=https://YOUR_APP_DOMAIN

# Optional standards-based Web Push for the installed web app/PWA. Generate one
# VAPID keypair, expose only its URL-safe public key here, and keep the matching
# private key in Supabase Edge Function secrets.
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=YOUR_URL_SAFE_VAPID_PUBLIC_KEY
# Supabase secrets (never EXPO_PUBLIC):
# WEB_PUSH_VAPID_PUBLIC_KEY=same public key as above
# WEB_PUSH_VAPID_PRIVATE_KEY=matching private key
# WEB_PUSH_VAPID_SUBJECT=mailto:notifications@YOUR_DOMAIN

# Optional second food-search provider. Open Food Facts and offline staples still work without it.
EXPO_PUBLIC_USDA_FDC_API_KEY=YOUR_USDA_FOODDATA_CENTRAL_KEY

# FatSecret is proxied by a Supabase Edge Function. Configure these with
# `supabase secrets set`; never expose them as EXPO_PUBLIC values:
# FATSECRET_CLIENT_ID
# FATSECRET_CLIENT_SECRET
# Optional paid-market settings: FATSECRET_SCOPE and FATSECRET_LOCALIZATION_ENABLED

# Add public legal/support pages before a store launch.
EXPO_PUBLIC_PRIVACY_URL=https://YOUR_DOMAIN/privacy
EXPO_PUBLIC_TERMS_URL=https://YOUR_DOMAIN/terms
EXPO_PUBLIC_SUPPORT_URL=https://YOUR_DOMAIN/support

# Google Health PWA sync uses server-only Supabase Edge secrets. These names
# are documented here for deployment discovery only: never uncomment them as
# EXPO_PUBLIC values and never commit real values to this file or `.env`.
# GOOGLE_HEALTH_CLIENT_ID (dedicated Health-only Web OAuth client; never reuse a login/Drive/etc client)
# GOOGLE_HEALTH_CLIENT_SECRET
# GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY
# GOOGLE_HEALTH_OAUTH_REDIRECT_URI
# GOOGLE_HEALTH_WEB_ORIGIN
# GOOGLE_HEALTH_ALLOWED_REDIRECT_ORIGINS
# GOOGLE_HEALTH_WEBHOOK_AUTHORIZATION
# GOOGLE_HEALTH_WORKER_SECRET
# Optional rotation: GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEYS
# Optional rotation: GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY_VERSION
# Optional rotation: GOOGLE_HEALTH_WEBHOOK_AUTHORIZATIONS
# Optional rotation: GOOGLE_HEALTH_WORKER_SECRETS
# Full setup and rotation runbook: docs/GOOGLE_HEALTH_WEB_SYNC.md
