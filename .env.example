# Optional. The app runs as a local demo without these values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional second food-search provider. Open Food Facts and offline staples still work without it.
EXPO_PUBLIC_USDA_FDC_API_KEY=YOUR_USDA_FOODDATA_CENTRAL_KEY

# Add public legal/support pages before a store launch.
EXPO_PUBLIC_PRIVACY_URL=https://YOUR_DOMAIN/privacy
EXPO_PUBLIC_TERMS_URL=https://YOUR_DOMAIN/terms
EXPO_PUBLIC_SUPPORT_URL=https://YOUR_DOMAIN/support
